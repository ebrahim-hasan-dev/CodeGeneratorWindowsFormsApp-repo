using <#= DataAccessLayerNameSpace #>;
<# } #>


<# if (!IsAppendMode) { #>
namespace <#= NamespaceName #>
{
    public class <#= TableSingleName #>Service
    {
<# } #>
<# if (IncludeAdd) { #>
        public static async Task<bool> AddAsync(cls<#= TableSingleName #> <#= TableSingleName #>)
        {
            if (<#= TableSingleName #> != null && <#= TableSingleName #>.IsFull())
            {
                return await <#= TableSingleName #>Repository.AddAsync(<#= TableSingleName #>);
            }
            else
            {
                return false;
            }
        }
<# } #>

<# if (IncludeUpdate) { #>
        public static async Task<bool> UpdateAsync(cls<#= TableSingleName #> <#= TableSingleName #>)
        {
<# if (Columns.Find(x => x.Name == UpdateParameterName).Type == "string") { #>
            if (<#= TableSingleName #> != null && !string.IsNullOrWhiteSpace(<#= TableSingleName #>.<#= UpdateParameterName.Replace("_", "") #>) && <#= TableSingleName #>.IsFull(true))
<# } #>
<# if (Columns.Find(x => x.Name == UpdateParameterName).Type != "string") { #>
            if (<#= TableSingleName #> != null && <#= TableSingleName #>.<#= HandleCorrectCheckParamerter(UpdateParameterName).Replace("_", "") #> && <#= TableSingleName #>.IsFull(true))
<# } #>
            {
                return await <#= TableSingleName #>Repository.UpdateAsync(<#= TableSingleName #>);
            }
            else
            {
                return false;
            }
        }
<# } #>

<# if (IncludeFind) { #>
        public static async Task<cls<#= TableSingleName #>?> FindAsync(<#= HandleParameter(FindParameterName).Replace("_", "") #>)
        {
            if (<#= HandleCorrectCheckParamerter(FindParameterName).Replace("_", "") #>)
            {
                return await <#= TableSingleName #>Repository.FindAsync(<#= FindParameterName.Replace("_", "") #>);
            }
            else
            {
                return null;
            }
        }
<# } #>

<# if (IncludeDelete) { #>
        public static async Task<bool> DeleteAsync(<#= HandleParameter(DeleteParameterName).Replace("_", "") #>)
        {
            if (<#= HandleCorrectCheckParamerter(DeleteParameterName).Replace("_", "") #>)
            {
                return await <#= TableSingleName #>Repository.DeleteAsync(<#= DeleteParameterName.Replace("_", "") #>);
            }
            else
            {
                return false;
            }
        }
<# } #>

<# if (IncludeGetAll) { #>
        public static async Task<List<cls<#= TableSingleName #>>?> GetAll<#= TableName #>Async()
        {
            return await <#= TableSingleName #>Repository.GetAll<#= TableName #>Async();
        }
<# } #>

<# if (IncludeExist) { #>
        public static async Task<bool> IsExistAsync(<#= HandleParameter(ExistParameterName).Replace("_", "") #>)
        {
            if (<#= HandleCorrectCheckParamerter(ExistParameterName).Replace("_", "") #>)
            {
                return await <#= TableSingleName #>Repository.IsExistAsync(<#= ExistParameterName.Replace("_", "") #>);
            }
            else
            {
                return false;
            }
        }
<# } #>

